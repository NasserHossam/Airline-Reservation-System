# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=airlines_aid

# Use a long, random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h

# Origin that is allowed to call this API (your frontend's URL)
FRONTEND_URL=http://127.0.0.1:5500

# Optional: booking confirmation emails via SMTP.
# If any of these are missing, the app still runs fine — emails are just skipped.
# Quick setup with Gmail: enable 2-Step Verification, then create an
# "App Password" at https://myaccount.google.com/apppasswords and use that
# as SMTP_PASS (NOT your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=youraddress@gmail.com

